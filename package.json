<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Lindner &amp; Buttenberg</title>
<meta name="application-name" content="L&B Bau">
<meta name="description" content="Fachbetrieb für Garten- und Landschaftsbau">
<meta name="theme-color" content="#2C2416">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="L&B Bau">
<script>
const manifestData={name:"Lindner & Buttenberg",short_name:"L&B Bau",description:"Fachbetrieb für Garten- und Landschaftsbau",start_url:".",display:"standalone",background_color:"#2C2416",theme_color:"#2C2416",orientation:"portrait-primary",icons:[{src:"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192'%3E%3Crect width='192' height='192' fill='%232C2416'/%3E%3Crect x='0' y='186' width='192' height='6' fill='%23A8C445'/%3E%3Ctext x='96' y='82' font-family='Georgia,serif' font-size='52' font-weight='700' fill='%23A8C445' text-anchor='middle'%3EL%26B%3C/text%3E%3Ctext x='96' y='130' font-family='Georgia,serif' font-size='14' fill='%23D4B896' text-anchor='middle'%3EGARTEN%3C/text%3E%3C/svg%3E",sizes:"192x192",type:"image/svg+xml"}]};
const mblob=new Blob([JSON.stringify(manifestData)],{type:'application/json'});
const ml=document.createElement('link');ml.rel='manifest';ml.href=URL.createObjectURL(mblob);document.head.appendChild(ml);
const iconSVG=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180"><rect width="180" height="180" rx="40" fill="#2C2416"/><rect x="0" y="174" width="180" height="6" rx="3" fill="#A8C445"/><text x="90" y="80" font-family="Georgia,serif" font-size="52" font-weight="700" fill="#A8C445" text-anchor="middle">L&amp;B</text><text x="90" y="120" font-family="Georgia,serif" font-size="13" fill="#D4B896" text-anchor="middle">GARTEN</text></svg>`;
const ib=new Blob([iconSVG],{type:'image/svg+xml'});const iu=URL.createObjectURL(ib);
['apple-touch-icon','apple-touch-icon-precomposed'].forEach(r=>{const l=document.createElement('link');l.rel=r;l.href=iu;document.head.appendChild(l);});
</script>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
:root{
  --earth:#2C2416;--soil:#3D3020;--bark:#5C4A2A;--moss:#4A6741;
  --lime:#A8C445;--sand:#D4B896;--cream:#F2EDE4;--fog:#E8E2D8;
  --rust:#B85C2A;--amber:#D4841A;--sky:#4A7FA5;--white:#FAFAF8;
  --blue:#4E7FE8;--blue-dim:rgba(78,127,232,.15);
  --safe-top:env(safe-area-inset-top,0px);--safe-bot:env(safe-area-inset-bottom,0px);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html{height:100%;}
body{font-family:'IBM Plex Sans',sans-serif;background:var(--earth);color:var(--cream);min-height:100%;display:flex;flex-direction:column;}

/* INSTALL BANNER */
#install-banner{display:none;background:linear-gradient(135deg,#1e3a52,#254d6e);border-bottom:2px solid var(--blue);padding:10px 16px;align-items:center;gap:10px;position:sticky;top:0;z-index:200;}
#install-banner.show{display:flex;}
#install-banner p{flex:1;font-size:12px;color:#a8cef5;line-height:1.4;}
#install-banner strong{color:#fff;display:block;font-size:13px;}
.btn-install{background:var(--blue);color:#fff;border:none;padding:8px 14px;border-radius:3px;font-size:12px;font-weight:600;cursor:pointer;}
.btn-dismiss{background:none;border:none;color:#7ab;font-size:18px;cursor:pointer;padding:4px;flex-shrink:0;}

/* IOS HINT */
#ios-hint{display:none;position:fixed;bottom:0;left:0;right:0;background:#1e3a52;border-top:2px solid var(--blue);padding:14px 16px calc(14px + var(--safe-bot));z-index:300;text-align:center;}
#ios-hint.show{display:block;}
#ios-hint p{font-size:13px;color:#a8cef5;line-height:1.6;}
#ios-hint strong{color:#fff;}
#ios-hint .close-hint{position:absolute;top:10px;right:14px;background:none;border:none;color:#7ab;font-size:20px;cursor:pointer;}

/* HEADER */
header{background:var(--soil);border-bottom:3px solid var(--lime);padding:0 16px;padding-top:var(--safe-top);display:flex;align-items:center;justify-content:space-between;min-height:62px;position:sticky;top:0;z-index:100;}
.logo-name{font-family:'IBM Plex Sans',sans-serif;font-weight:600;font-size:16px;letter-spacing:.5px;color:var(--cream);line-height:1.1;}
.logo-name .amp{color:var(--blue);margin:0 2px;}
.logo-sub{font-size:9px;font-weight:300;letter-spacing:1.5px;text-transform:uppercase;color:var(--sand);}
.logo-accent{width:32px;height:2px;background:linear-gradient(90deg,var(--lime),var(--blue));margin-top:4px;border-radius:1px;}
.header-right{display:flex;align-items:center;gap:10px;}
.today-badge{font-family:'IBM Plex Mono',monospace;font-size:10px;background:var(--bark);color:var(--sand);padding:3px 8px;border-radius:2px;}

/* NAV */
nav{background:var(--soil);border-bottom:1px solid var(--bark);display:flex;overflow-x:auto;scrollbar-width:none;}
nav::-webkit-scrollbar{display:none;}
.nav-tab{flex:0 0 auto;padding:0 15px;height:44px;display:flex;align-items:center;gap:5px;font-size:12px;font-weight:500;color:var(--sand);cursor:pointer;border-bottom:3px solid transparent;transition:all .2s;white-space:nowrap;}
.nav-tab:hover{color:var(--cream);}
.nav-tab.active{color:var(--lime);border-bottom-color:var(--lime);background:rgba(168,196,69,.06);}

/* MAIN */
main{flex:1;padding:18px 16px calc(18px + var(--safe-bot));max-width:980px;width:100%;margin:0 auto;}
.section{display:none;}.section.active{display:block;}

/* SEC HEADER */
.sec-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:20px;gap:10px;flex-wrap:wrap;}
.sec-title{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:2px;color:var(--cream);line-height:1;}
.sec-title span{color:var(--lime);}

/* BTN */
.btn{display:inline-flex;align-items:center;gap:5px;padding:8px 16px;border-radius:3px;font-family:'IBM Plex Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:all .18s;letter-spacing:.3px;}
.btn-primary{background:var(--lime);color:var(--earth);}
.btn-primary:hover{background:#bcd64f;}
.btn-secondary{background:var(--bark);color:var(--cream);}
.btn-secondary:hover{background:#7a633a;}
.btn-danger{background:var(--rust);color:var(--white);}
.btn-danger:hover{background:#d06830;}
.btn-ghost{background:transparent;color:var(--sand);border:1px solid var(--bark);}
.btn-ghost:hover{border-color:var(--sand);color:var(--cream);}
.btn-pdf{background:#1e3a52;color:#7ec8f0;border:1px solid #4A7FA5;}
.btn-pdf:hover{background:#254d6e;}
.btn-share{background:rgba(78,127,232,.18);color:var(--blue);border:1px solid rgba(78,127,232,.4);}
.btn-share:hover{background:rgba(78,127,232,.3);}
.btn-sm{padding:5px 10px;font-size:11px;}
.btn-icon{padding:7px;border-radius:3px;}
.btn-group{display:flex;gap:7px;flex-wrap:wrap;}

/* CARD */
.card{background:var(--soil);border:1px solid var(--bark);border-radius:4px;padding:16px 18px;margin-bottom:14px;}

/* FORM */
.form-group{margin-bottom:14px;}
.form-row{display:flex;gap:10px;flex-wrap:wrap;}
.form-row .form-group{flex:1;min-width:130px;}
label{display:block;font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--sand);margin-bottom:5px;}
input[type=text],input[type=date],input[type=number],input[type=time],input[type=email],input[type=tel],textarea,select{width:100%;background:var(--earth);border:1px solid var(--bark);border-radius:3px;color:var(--cream);font-family:'IBM Plex Sans',sans-serif;font-size:14px;padding:9px 12px;outline:none;transition:border-color .2s;-webkit-appearance:none;appearance:none;}
input:focus,textarea:focus,select:focus{border-color:var(--lime);}
textarea{resize:vertical;min-height:80px;}
select option{background:var(--earth);}
input[type=file]{display:none;}

/* SECTION DIVIDER IN FORM */
.form-section{font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:1.5px;color:var(--lime);margin:18px 0 10px;padding-bottom:4px;border-bottom:1px solid var(--bark);}

/* BADGE */
.badge{display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:600;letter-spacing:.4px;padding:3px 7px;border-radius:2px;}
.badge-green{background:rgba(107,143,62,.25);color:var(--lime);border:1px solid rgba(107,143,62,.4);}
.badge-amber{background:rgba(212,132,26,.2);color:var(--amber);border:1px solid rgba(212,132,26,.3);}
.badge-rust{background:rgba(184,92,42,.2);color:var(--rust);border:1px solid rgba(184,92,42,.3);}
.badge-sky{background:rgba(74,127,165,.2);color:var(--sky);border:1px solid rgba(74,127,165,.3);}
.badge-blue{background:var(--blue-dim);color:var(--blue);border:1px solid rgba(78,127,232,.3);}
.badge-gray{background:rgba(92,74,42,.3);color:var(--sand);border:1px solid var(--bark);}

/* META */
.meta-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:8px;}
.meta-item{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--sand);display:flex;align-items:center;gap:3px;}

/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(12,10,6,.9);z-index:200;align-items:flex-end;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal{background:var(--soil);border:1px solid var(--bark);border-radius:10px 10px 0 0;width:100%;max-width:640px;max-height:93vh;overflow-y:auto;padding:22px 18px calc(20px + var(--safe-bot));}
@media(min-width:660px){.modal-overlay{align-items:center;padding:20px;}.modal{border-radius:6px;max-height:90vh;}}
.modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:var(--lime);}
.modal-close{background:none;border:none;color:var(--sand);font-size:22px;cursor:pointer;padding:4px;}
.modal-footer{display:flex;gap:8px;justify-content:flex-end;margin-top:18px;}

/* MASCHINEN ROW */
.maschine-row{display:flex;gap:8px;align-items:center;margin-bottom:8px;}
.maschine-row input[type=text]{flex:2;}
.maschine-row input[type=number]{flex:1;min-width:80px;}
.maschine-row .rm-btn{background:var(--rust);border:none;color:#fff;border-radius:3px;padding:6px 10px;cursor:pointer;font-size:14px;flex-shrink:0;}

/* LIEFERSCHEIN UPLOAD */
.ls-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:8px;margin-top:8px;}
.ls-thumb{position:relative;aspect-ratio:3/4;border-radius:3px;overflow:hidden;background:var(--earth);border:1px solid var(--bark);}
.ls-thumb img{width:100%;height:100%;object-fit:cover;}
.ls-thumb .rm-ls{position:absolute;top:2px;right:2px;background:rgba(184,92,42,.9);border:none;color:#fff;border-radius:2px;padding:2px 5px;font-size:11px;cursor:pointer;}
.ls-add{aspect-ratio:3/4;border:2px dashed var(--bark);border-radius:3px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;gap:4px;font-size:11px;color:var(--sand);transition:all .2s;}
.ls-add:hover{border-color:var(--lime);color:var(--lime);}
.ls-add .plus{font-size:22px;}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:20px;}
.stat-card{background:var(--soil);border:1px solid var(--bark);border-radius:4px;padding:14px 16px;position:relative;overflow:hidden;}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.stat-card.green::before{background:var(--lime);}
.stat-card.amber::before{background:var(--amber);}
.stat-card.sky::before{background:var(--sky);}
.stat-card.blue::before{background:var(--blue);}
.stat-value{font-family:'Bebas Neue',sans-serif;font-size:36px;line-height:1;color:var(--cream);margin-bottom:3px;}
.stat-label{font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--sand);}
.stat-icon{position:absolute;right:12px;top:12px;font-size:20px;opacity:.3;}

/* BERICHT CARD */
.bericht-card{background:var(--soil);border:1px solid var(--bark);border-left:4px solid var(--lime);border-radius:4px;padding:14px 16px;margin-bottom:10px;}
.bericht-card.amber{border-left-color:var(--amber);}
.bericht-card.rust{border-left-color:var(--rust);}
.bericht-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px;flex-wrap:wrap;}
.bericht-date{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:1px;color:var(--cream);}
.bericht-projekt{font-size:12px;color:var(--sand);margin-bottom:5px;}
.bericht-text{font-size:12px;color:var(--fog);line-height:1.5;}
.bericht-personal{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
.personal-chip{font-family:'IBM Plex Mono',monospace;font-size:10px;padding:3px 7px;border-radius:2px;background:rgba(74,103,65,.3);color:var(--lime);border:1px solid rgba(74,103,65,.5);}
.maschine-chip{background:rgba(74,127,165,.2);color:var(--sky);border:1px solid rgba(74,127,165,.3);}

/* LS THUMB IN BERICHT */
.ls-list{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
.ls-bericht-thumb{width:48px;height:60px;border-radius:3px;overflow:hidden;border:1px solid var(--bark);cursor:pointer;}
.ls-bericht-thumb img{width:100%;height:100%;object-fit:cover;}

/* PHOTO GALLERY */
.photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;margin-top:4px;}
.photo-cell{background:var(--earth);border:1px solid var(--bark);border-radius:5px;overflow:hidden;position:relative;display:flex;flex-direction:column;}
.photo-img-wrap{aspect-ratio:4/3;overflow:hidden;display:flex;align-items:center;justify-content:center;cursor:pointer;}
.photo-img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .2s;}
.photo-img-wrap:active img{transform:scale(.97);}
.photo-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:30px;}
.photo-actions{display:flex;gap:0;border-top:1px solid var(--bark);}
.photo-action-btn{flex:1;padding:7px 4px;background:none;border:none;color:var(--sand);font-size:12px;cursor:pointer;transition:background .15s;display:flex;align-items:center;justify-content:center;gap:3px;}
.photo-action-btn:hover{background:rgba(255,255,255,.06);}
.photo-action-btn.del{color:var(--rust);}
.photo-action-btn.del:hover{background:rgba(184,92,42,.15);}
.photo-action-btn.share{color:var(--blue);}
.photo-action-btn + .photo-action-btn{border-left:1px solid var(--bark);}
.photo-caption{font-size:9px;padding:4px 6px;color:var(--sand);font-family:'IBM Plex Mono',monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:var(--earth);border-top:1px solid var(--bark);}
.photo-add-cell{border:2px dashed var(--bark);border-radius:5px;aspect-ratio:4/3;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;gap:7px;color:var(--sand);font-size:12px;transition:all .2s;}
.photo-add-cell:hover{border-color:var(--lime);color:var(--lime);}
.photo-add-cell .plus{font-size:28px;}

/* UPLOAD ZONE */
.upload-zone{border:2px dashed var(--bark);border-radius:5px;padding:24px 16px;text-align:center;cursor:pointer;transition:all .2s;margin-bottom:14px;}
.upload-zone:hover,.upload-zone.dragover{border-color:var(--lime);background:rgba(168,196,69,.04);}
.upload-zone .up-icon{font-size:32px;margin-bottom:8px;}
.upload-zone p{font-size:12px;color:var(--sand);}
.upload-zone strong{color:var(--lime);}

/* SEARCH */
.search-box{position:relative;margin-bottom:16px;}
.search-box input{padding-left:36px;}
.search-box .search-icon{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--sand);font-size:14px;pointer-events:none;}

/* FILTER */
.filter-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
.filter-chip{padding:4px 11px;border-radius:20px;font-size:11px;font-weight:500;cursor:pointer;border:1px solid var(--bark);background:transparent;color:var(--sand);transition:all .2s;}
.filter-chip:hover{border-color:var(--sand);color:var(--cream);}
.filter-chip.active{background:var(--moss);border-color:var(--lime);color:var(--lime);}

/* EMPTY */
.empty-state{text-align:center;padding:44px 16px;color:var(--sand);}
.empty-state .em-icon{font-size:44px;margin-bottom:12px;opacity:.5;}
.empty-state p{font-size:13px;margin-bottom:14px;}

/* TOAST */
#toast{position:fixed;bottom:calc(24px + var(--safe-bot));right:16px;left:16px;max-width:360px;margin:0 auto;background:var(--moss);color:var(--white);padding:11px 16px;border-radius:4px;font-size:13px;font-weight:500;z-index:999;transform:translateY(120px);opacity:0;transition:all .3s;display:flex;align-items:center;gap:7px;border-left:4px solid var(--lime);box-shadow:0 4px 20px rgba(0,0,0,.5);}
#toast.show{transform:translateY(0);opacity:1;}
@media(min-width:500px){#toast{left:auto;width:auto;}}

/* WEATHER */
.weather-row{display:flex;gap:6px;}
.weather-opt{flex:1;padding:8px 3px;background:var(--earth);border:2px solid var(--bark);border-radius:3px;text-align:center;cursor:pointer;transition:all .2s;font-size:18px;}
.weather-opt:hover{border-color:var(--sand);}
.weather-opt.selected{border-color:var(--lime);background:rgba(168,196,69,.08);}
.weather-opt span{display:block;font-size:9px;margin-top:2px;color:var(--sand);}

/* SCAN */
.scan-card{background:var(--earth);border:1px solid var(--bark);border-radius:4px;padding:12px 14px;margin-bottom:9px;display:flex;gap:12px;align-items:flex-start;}
.scan-thumb{width:50px;height:63px;background:var(--soil);border:1px solid var(--bark);border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.scan-meta{flex:1;min-width:0;}
.scan-title{font-size:13px;font-weight:600;color:var(--cream);margin-bottom:3px;}
.scan-detail{font-size:11px;color:var(--sand);font-family:'IBM Plex Mono',monospace;}
.scan-tags{margin-top:5px;display:flex;gap:4px;flex-wrap:wrap;}

/* PROJEKT */
.proj-card{background:var(--soil);border:1px solid var(--bark);border-radius:4px;padding:16px 18px;margin-bottom:12px;}
.proj-card-header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:8px;flex-wrap:wrap;}
.proj-name{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1px;color:var(--cream);}
.proj-addr{font-size:11px;color:var(--sand);margin-top:2px;font-family:'IBM Plex Mono',monospace;}
.proj-info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-top:10px;}
.proj-info-cell{background:var(--earth);border-radius:3px;padding:8px 10px;}
.proj-info-label{font-size:9px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--sand);margin-bottom:3px;}
.proj-info-value{font-size:13px;color:var(--cream);}
.progress-bar{height:5px;background:var(--earth);border-radius:3px;overflow:hidden;margin-top:6px;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--moss),var(--lime));border-radius:3px;}
/* Projekt-Fotos */
.proj-foto-grid{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
.proj-foto-thumb{width:70px;height:70px;border-radius:3px;overflow:hidden;border:1px solid var(--bark);cursor:pointer;position:relative;}
.proj-foto-thumb img{width:100%;height:100%;object-fit:cover;}
.proj-foto-add{width:70px;height:70px;border:2px dashed var(--bark);border-radius:3px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:22px;color:var(--sand);transition:all .2s;}
.proj-foto-add:hover{border-color:var(--lime);color:var(--lime);}

/* MITARBEITER */
.ma-card{background:var(--soil);border:1px solid var(--bark);border-radius:4px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:14px;}
.ma-avatar{width:44px;height:44px;border-radius:50%;background:var(--moss);border:2px solid var(--lime);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:18px;color:var(--lime);flex-shrink:0;}
.ma-info{flex:1;min-width:0;}
.ma-name{font-size:14px;font-weight:600;color:var(--cream);}
.ma-role{font-size:11px;color:var(--sand);margin-top:1px;}
.ma-meta{display:flex;gap:7px;flex-wrap:wrap;margin-top:5px;}
.ma-actions{display:flex;gap:5px;flex-shrink:0;}

/* TAGS */
.tags-input{display:flex;flex-wrap:wrap;gap:5px;align-items:center;background:var(--earth);border:1px solid var(--bark);border-radius:3px;padding:5px 9px;min-height:38px;}
.tag-pill{background:var(--moss);color:var(--lime);font-size:10px;padding:2px 7px;border-radius:20px;display:flex;align-items:center;gap:3px;}
.tag-pill .rm{cursor:pointer;opacity:.7;}
.tags-input input{background:none;border:none;outline:none;font-size:13px;color:var(--cream);min-width:80px;flex:1;padding:0;}

/* FILE LIST */
.file-row{display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--earth);border:1px solid var(--bark);border-radius:3px;margin-bottom:7px;}
.file-icon{width:36px;height:36px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.file-icon-pdf{background:rgba(184,92,42,.2);}
.file-icon-img{background:rgba(107,143,62,.2);}
.file-icon-doc{background:rgba(74,127,165,.2);}
.file-icon-xls{background:rgba(74,165,127,.2);}
.file-meta{flex:1;min-width:0;}
.file-name{font-size:13px;font-weight:500;color:var(--cream);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.file-info{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--sand);margin-top:2px;}

/* EXPORT PANEL */
.export-panel{background:var(--soil);border:1px solid var(--sky);border-radius:4px;padding:14px 16px;margin-bottom:14px;border-left:4px solid var(--sky);}
.export-panel-title{font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:1px;color:var(--sky);margin-bottom:10px;}

.hidden{display:none!important;}
@media(max-width:500px){
  .stats-grid{grid-template-columns:repeat(2,1fr);}
  .photo-grid{grid-template-columns:repeat(auto-fill,minmax(110px,1fr));}
  .proj-info-grid{grid-template-columns:repeat(2,1fr);}
}
</style>
</head>
<body>

<div id="install-banner">
  <div style="font-size:22px">🌿</div>
  <p><strong>App installieren</strong>Zum Homescreen hinzufügen für Offline-Nutzung</p>
  <button class="btn-install" onclick="installApp()">Installieren</button>
  <button class="btn-dismiss" onclick="dismissInstall()">✕</button>
</div>

<header>
  <div>
    <div class="logo-name">Lindner<span class="amp">&</span>Buttenberg</div>
    <div class="logo-sub">Garten · Landschaftsbau</div>
    <div class="logo-accent"></div>
  </div>
  <div class="header-right">
    <div class="today-badge" id="todayBadge"></div>
  </div>
</header>

<nav>
  <div class="nav-tab active" onclick="showSection('dashboard')" id="tab-dashboard">🏠 Start</div>
  <div class="nav-tab" onclick="showSection('projekte')" id="tab-projekte">🏗 Projekte</div>
  <div class="nav-tab" onclick="showSection('mitarbeiter')" id="tab-mitarbeiter">👷 Mitarbeiter</div>
  <div class="nav-tab" onclick="showSection('berichte')" id="tab-berichte">📋 Berichte</div>
  <div class="nav-tab" onclick="showSection('fotos')" id="tab-fotos">📷 Fotothek</div>
  <div class="nav-tab" onclick="showSection('dokumente')" id="tab-dokumente">📁 Dokumente</div>
  <div class="nav-tab" onclick="showSection('scans')" id="tab-scans">🔍 LV & Scans</div>
</nav>

<main>

<!-- ══ DASHBOARD ══ -->
<section class="section active" id="section-dashboard">
