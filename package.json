// ══════════ PDF EXPORT ══════════
const FIRM='Lindner & Buttenberg',FIRM_SUB='Fachbetrieb fuer Garten- und Landschaftsbau';
const CG=[74,127,65],CD=[44,36,22],CS=[180,155,120],CB=[78,127,232],CL=[168,196,69];

function pdfHeader(doc,title,right){
  doc.setFillColor(...CD);doc.rect(0,0,210,32,'F');
  doc.setFillColor(...CG);doc.rect(0,30,210,2,'F');
  doc.setFillColor(...CB);doc.rect(0,32,210,1,'F');
  doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(...CL);doc.text(FIRM.toUpperCase(),14,11);
  doc.setFont('helvetica','normal');doc.setFontSize(7);doc.setTextColor(...CS);doc.text(FIRM_SUB,14,17);
  doc.setFont('helvetica','bold');doc.setFontSize(15);doc.setTextColor(255,255,255);doc.text(title,14,27);
  if(right){doc.setFontSize(8);doc.setFont('helvetica','normal');doc.setTextColor(...CS);doc.text(right,196,27,'right');}
}
function pdfFooter(doc,pg,total){
  doc.setDrawColor(...CG);doc.setLineWidth(.4);doc.line(10,285,200,285);
  doc.setFontSize(7);doc.setFont('helvetica','normal');doc.setTextColor(...CS);
  doc.text(FIRM+' · '+FIRM_SUB,14,291);
  doc.text(`Seite ${pg}${total?' / '+total:''}`,196,291,'right');
}
function pdfSec(doc,t,y){
  doc.setFillColor(228,232,222);doc.rect(10,y-4,190,7,'F');
  doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(...CD);doc.text(t,14,y);
  return y+5;
}

function toggleExportPanel(){document.getElementById('export-panel').classList.toggle('hidden');populateProjectSelects();}
function openExportPanel(){document.getElementById('export-panel').classList.remove('hidden');populateProjectSelects();}

function exportEinzelBerichtPDF(id){
  const b=S.berichte.find(x=>x.id===id);if(!b)return;
  const {jsPDF}=window.jspdf;const doc=new jsPDF();
  pdfHeader(doc,'TAGESBERICHT',fmtDateLong(b.datum));
  let y=40;
  // Info block
  doc.setFillColor(245,242,237);doc.rect(10,y-4,190,36,'F');
  function row(l,v,x1,x2,yy){doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(...CD);doc.text(l,x1,yy);doc.setFont('helvetica','normal');doc.setTextColor(60,50,35);doc.text(String(v||'–'),x2,yy);}
  row('Projekt:',b.projekt,14,38,y+3);row('Datum:',fmtDateLong(b.datum),14,38,y+10);
  row('Wetter:',b.wetter||'–',14,38,y+17);row('Status:',b.status,110,128,y+17);
  y+=44;
  // Personal
  y=pdfSec(doc,'PERSONALSTUNDEN',y);
  doc.setFillColor(250,248,244);doc.rect(10,y,190,24,'F');
  doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(...CD);
  doc.text('Kategorie',14,y+6);doc.text('Anzahl',100,y+6,'center');doc.text('Std./Pers.',145,y+6,'center');doc.text('Gesamt Std.',185,y+6,'right');
  doc.setFont('helvetica','normal');doc.setTextColor(60,50,35);
  function prow(label,anz,std,yy){
    if(!anz)return;
    doc.text(label,14,yy);doc.text(String(anz),100,yy,'center');doc.text(String(std),145,yy,'center');doc.text(String((anz*std).toFixed(1)),185,yy,'right');
  }
  prow('Vorarbeiter',b.vorarbeiter?.anz||0,b.vorarbeiter?.std||0,y+12);
  prow('Facharbeiter',b.facharbeiter?.anz||0,b.facharbeiter?.std||0,y+18);
  prow('Helfer',b.helfer?.anz||0,b.helfer?.std||0,y+24);
  y+=30;
  // Maschinen
  if(b.maschinen&&b.maschinen.length){
    y=pdfSec(doc,'MASCHINENSTUNDEN',y);
    doc.setFillColor(250,248,244);doc.rect(10,y,190,b.maschinen.length*8+4,'F');
    doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(...CD);
    doc.text('Maschine',14,y+6);doc.text('Stunden',185,y+6,'right');
    doc.setFont('helvetica','normal');doc.setTextColor(60,50,35);
    b.maschinen.forEach((m,i)=>{doc.text(m.name,14,y+12+i*7);doc.text(String(m.std)+' h',185,y+12+i*7,'right');});
    y+=b.maschinen.length*7+10;
  }
  // Tätigkeiten
  function sec(t,txt){
    if(!txt||txt==='Keine'||txt==='–')return;
    y=pdfSec(doc,t,y);
    doc.setFont('helvetica','normal');doc.setFontSize(10);doc.setTextColor(55,45,30);
    const lines=doc.splitTextToSize(txt,182);doc.text(lines,14,y);y+=lines.length*5+9;
  }
  sec('DURCHGEFUEHRTE ARBEITEN',b.arbeiten);
  sec('MATERIALVERBRAUCH',b.material);
  sec('BESONDERHEITEN / PROBLEME',b.probleme);
  // Lieferscheine Hinweis
  if(b.lieferscheine&&b.lieferscheine.length){
    y=pdfSec(doc,'LIEFERSCHEINE',y);
    doc.setFont('helvetica','normal');doc.setFontSize(9);doc.setTextColor(55,45,30);
    doc.text(`${b.lieferscheine.length} Lieferschein-Foto(s) angehaengt.`,14,y);y+=10;
  }
  pdfFooter(doc,1,1);
  doc.save(`Tagesbericht_${b.datum}_${b.projekt.replace(/[^a-z0-9]/gi,'_')}.pdf`);
  toast('PDF erstellt!','📄');
}

function exportBerichtePDF(){
  const projekt=document.getElementById('exp-projekt').value;
  const von=document.getElementById('exp-von').value;
  const bis=document.getElementById('exp-bis').value;
  let data=S.berichte;
  if(projekt)data=data.filter(b=>b.projekt===projekt);
  if(von)data=data.filter(b=>b.datum>=von);
  if(bis)data=data.filter(b=>b.datum<=bis);
  if(!data.length){toast('Keine Berichte im Filter.','⚠️');return;}
  const {jsPDF}=window.jspdf;const doc=new jsPDF();
  // Deckblatt
  doc.setFillColor(...CD);doc.rect(0,0,210,297,'F');
  doc.setFillColor(...CG);doc.rect(0,240,210,2,'F');doc.setFillColor(...CB);doc.rect(0,242,210,1,'F');
  doc.setFont('helvetica','bold');doc.setFontSize(9);doc.setTextColor(...CL);doc.text(FIRM.toUpperCase(),20,60);
  doc.setFont('helvetica','normal');doc.setFontSize(7);doc.setTextColor(...CS);doc.text(FIRM_SUB,20,67);
  doc.setFont('helvetica','bold');doc.setFontSize(26);doc.setTextColor(255,255,255);doc.text('TAGESBERICHT',20,98);doc.text('MAPPE',20,112);
  doc.setFillColor(...CL);doc.rect(20,118,60,2,'F');
  doc.setFont('helvetica','normal');doc.setFontSize(10);doc.setTextColor(...CS);
  if(projekt)doc.text('Projekt: '+projekt,20,130);
  doc.text((von&&bis)?`Zeitraum: ${fmtDate(von)} – ${fmtDate(bis)}`:'Alle Berichte',20,140);
  doc.text(`${data.length} Bericht(e) · Erstellt: ${fmtDate(new Date().toISOString().split('T')[0])}`,20,150);
  doc.setFontSize(7);doc.setTextColor(...CS);doc.text(FIRM+' · '+FIRM_SUB,20,250);

  data.forEach((b,idx)=>{
    doc.addPage();
    pdfHeader(doc,'TAGESBERICHT',`${idx+1} / ${data.length}`);
    let y=40;
    doc.setFillColor(245,242,237);doc.rect(10,y-4,190,14,'F');
    function row(l,v,x1,x2,yy){doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(...CD);doc.text(l,x1,yy);doc.setFont('helvetica','normal');doc.setTextColor(60,50,35);doc.text(String(v||'–'),x2,yy);}
    row('Datum:',fmtDateLong(b.datum),14,34,y+2);
    row('Projekt:',b.projekt,14,34,y+9);
    y+=18;
    // Personal table
    const hasPersonal=(b.vorarbeiter?.anz||0)+(b.facharbeiter?.anz||0)+(b.helfer?.anz||0)>0;
    if(hasPersonal){
      y=pdfSec(doc,'PERSONAL',y);
      const prows=[['Vorarbeiter',b.vorarbeiter],[' Facharbeiter',b.facharbeiter],['Helfer',b.helfer]].filter(r=>r[1]?.anz>0);
      prows.forEach(([label,pr])=>{
        doc.setFont('helvetica','normal');doc.setFontSize(9);doc.setTextColor(55,45,30);
        doc.text(`${label}: ${pr.anz}x ${pr.std}h = ${(pr.anz*pr.std).toFixed(1)}h`,14,y);y+=6;
      });
      y+=3;
    }
    if(b.maschinen&&b.maschinen.length){
      y=pdfSec(doc,'MASCHINEN',y);
      b.maschinen.forEach(m=>{doc.setFont('helvetica','normal');doc.setFontSize(9);doc.setTextColor(55,45,30);doc.text(`${m.name}: ${m.std}h`,14,y);y+=6;});y+=3;
    }
    function sec(t,txt){
      if(!txt||txt==='Keine'||txt==='–')return;
      if(y>265){doc.addPage();pdfHeader(doc,'TAGESBERICHT','(Forts.)');y=40;}
      y=pdfSec(doc,t,y);
      doc.setFont('helvetica','normal');doc.setFontSize(10);doc.setTextColor(55,45,30);
      const lines=doc.splitTextToSize(txt,182);doc.text(lines,14,y);y+=lines.length*5+8;
    }
    sec('ARBEITEN',b.arbeiten);sec('MATERIAL',b.material);sec('BESONDERHEITEN',b.probleme);
    pdfFooter(doc,idx+2);
  });
  doc.save(`Berichte_${new Date().toISOString().split('T')[0]}.pdf`);
  toast(`PDF mit ${data.length} Berichten!`,'📄');
}

function exportProjektPDF(id){
  const p=S.projekte.find(x=>x.id===id);if(!p)return;
  const berichte=S.berichte.filter(b=>b.projekt===p.name);
  const {jsPDF}=window.jspdf;const doc=new jsPDF();
  pdfHeader(doc,'PROJEKTBERICHT',fmtDate(new Date().toISOString().split('T')[0]));
  let y=40;
  const nl=doc.splitTextToSize(p.name,180);
  doc.setFont('helvetica','bold');doc.setFontSize(14);doc.setTextColor(...CD);doc.text(nl,14,y);y+=nl.length*7+4;
  doc.setFillColor(245,242,237);doc.rect(10,y-4,190,30,'F');
  function row(l,v,x1,x2,yy){doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(...CD);doc.text(l,x1,yy);doc.setFont('helvetica','normal');doc.setTextColor(60,50,35);doc.text(String(v||'–'),x2,yy);}
  row('Auftraggeber:',p.ag,14,52,y+4);row('Status:',p.status,110,128,y+4);
  row('Adresse:',p.addr,14,46,y+11);
  row('Beginn:',fmtDate(p.start),14,40,y+18);row('Ende:',fmtDate(p.end),110,122,y+18);
  row('Verantw.:',p.verantw,14,44,y+25);
  y+=36;
  if(p.desc){y=pdfSec(doc,'BESCHREIBUNG',y);doc.setFont('helvetica','normal');doc.setFontSize(10);doc.setTextColor(55,45,30);const lines=doc.splitTextToSize(p.desc,182);doc.text(lines,14,y);y+=lines.length*5+8;}
  y=pdfSec(doc,`FORTSCHRITT: ${p.fortschritt||0}%`,y);
  doc.setFillColor(210,205,195);doc.rect(14,y,182,5,'F');doc.setFillColor(...CG);doc.rect(14,y,(182*(p.fortschritt||0)/100),5,'F');y+=14;
  if(berichte.length){
    y=pdfSec(doc,`TAGESBERICHTE (${berichte.length})`,y);
    berichte.forEach(b=>{
      if(y>272){doc.addPage();pdfHeader(doc,'PROJEKTBERICHT','(Forts.)');y=40;}
      doc.setDrawColor(...CS);doc.setLineWidth(.2);doc.rect(12,y-3,186,10);
      doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(...CD);doc.text(fmtDate(b.datum),14,y+3);
      doc.setFont('helvetica','normal');doc.setTextColor(55,45,30);
      const t=doc.splitTextToSize(b.arbeiten,142);doc.text(t[0]+(t.length>1?'…':''),38,y+3);
      doc.setTextColor(...CG);doc.text(b.status,196,y+3,'right');y+=12;
    });
  }
  pdfFooter(doc,1);
  doc.save(`Projekt_${p.name.replace(/[^a-z0-9]/gi,'_')}.pdf`);
  toast('Projektbericht PDF!','📄');
}

function exportMitarbeiterPDF(){
  const {jsPDF}=window.jspdf;const doc=new jsPDF();
  pdfHeader(doc,'MITARBEITERLISTE',`${S.mitarbeiter.length} Personen`);
  let y=40;
  doc.setFillColor(...CB);doc.rect(10,y-4,190,8,'F');
  doc.setFont('helvetica','bold');doc.setFontSize(8);doc.setTextColor(255,255,255);
  doc.text('Name',14,y+1);doc.text('Rolle',68,y+1);doc.text('Telefon',118,y+1);doc.text('Eintr.',168,y+1);
  y+=10;
  S.mitarbeiter.forEach((m,i)=>{
    if(y>272){doc.addPage();pdfHeader(doc,'MITARBEITERLISTE','(Forts.)');y=40;}
    if(i%2===0){doc.setFillColor(245,242,237);doc.rect(10,y-4,190,10,'F');}
    doc.setFont('helvetica','bold');doc.setFontSize(9);doc.setTextColor(...CD);doc.text(`${m.vorname} ${m.nachname}`,14,y+2);
    doc.setFont('helvetica','normal');doc.setTextColor(60,50,35);doc.text(m.rolle,68,y+2);doc.text(m.tel||'–',118,y+2);doc.text(fmtDate(m.datum),168,y+2);
    y+=10;if(m.quali.length){doc.setFontSize(7);doc.setTextColor(...CS);doc.text('Qualif.: '+m.quali.join(', '),14,y);y+=5;}y+=2;
  });
  pdfFooter(doc,1);
  doc.save('Mitarbeiterliste_Lindner_Buttenberg.pdf');
  toast('Mitarbeiterliste PDF!','📄');
}

// ══════════ HELPER ══════════
function fmtDate(d){if(!d)return'–';try{return new Date(d).toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit',year:'numeric'});}catch{return d;}}
function fmtDateLong(d){if(!d)return'–';try{return new Date(d).toLocaleDateString('de-DE',{weekday:'short',day:'2-digit',month:'long',year:'numeric'});}catch{return d;}}
</script>
