    <div class="sec-title">Über<span>sicht</span></div>
    <button class="btn btn-pdf btn-sm" onclick="showSection('berichte');setTimeout(openExportPanel,150)">📄 PDF-Export</button>
  </div>
  <div class="stats-grid">
    <div class="stat-card green"><div class="stat-icon">🏗</div><div class="stat-value" id="stat-proj">0</div><div class="stat-label">Projekte</div></div>
    <div class="stat-card amber"><div class="stat-icon">👷</div><div class="stat-value" id="stat-ma">0</div><div class="stat-label">Mitarbeiter</div></div>
    <div class="stat-card sky"><div class="stat-icon">📋</div><div class="stat-value" id="stat-berichte">0</div><div class="stat-label">Tagesberichte</div></div>
    <div class="stat-card blue"><div class="stat-icon">📷</div><div class="stat-value" id="stat-fotos">0</div><div class="stat-label">Fotos</div></div>
  </div>
  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
