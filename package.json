  list.innerHTML=data.map(m=>`
    <div class="ma-card">
      <div class="ma-avatar">${(m.vorname[0]+(m.nachname[0]||'')).toUpperCase()}</div>
      <div class="ma-info">
        <div class="ma-name">${m.vorname} ${m.nachname}</div>
        <div class="ma-role">${m.rolle}</div>
        <div class="ma-meta">
          ${m.tel?`<span class="meta-item">📞 ${m.tel}</span>`:''}
          ${m.datum?`<span class="meta-item">seit ${fmtDate(m.datum)}</span>`:''}
        </div>
        ${m.quali.length?`<div style="display:flex;gap:4px;flex-wrap:wrap;margin-top:6px">${m.quali.map(q=>`<span class="badge badge-blue" style="font-size:9px">${q}</span>`).join('')}</div>`:''}
      </div>
      <div class="ma-actions">
        <button class="btn btn-ghost btn-icon btn-sm" onclick="editMitarbeiter(${m.id})">✏</button>
        <button class="btn btn-danger btn-icon btn-sm" onclick="deleteMitarbeiter(${m.id})">🗑</button>
      </div>
    </div>`).join('');
}
function saveMitarbeiter(){
  const vn=document.getElementById('ma-vorname').value.trim();const nn=document.getElementById('ma-nachname').value.trim();
  if(!vn||!nn){toast('Name erforderlich.','⚠️');return;}
  S.mitarbeiter.push({id:Date.now(),vorname:vn,nachname:nn,rolle:document.getElementById('ma-rolle').value,tel:document.getElementById('ma-tel').value,email:document.getElementById('ma-email').value,datum:document.getElementById('ma-datum').value,quali:[...maTags],notiz:document.getElementById('ma-notiz').value});
  maTags=[];renderMaTags();
  ['ma-vorname','ma-nachname','ma-tel','ma-email','ma-notiz'].forEach(id=>document.getElementById(id).value='');
  closeModal('modal-mitarbeiter');populateProjectSelects();renderMitarbeiter();updateStats();toast('Mitarbeiter gespeichert!','👷');
}
function deleteMitarbeiter(id){if(!confirm('Löschen?'))return;S.mitarbeiter=S.mitarbeiter.filter(m=>m.id!==id);renderMitarbeiter();updateStats();toast('Gelöscht.','🗑');}
function editMitarbeiter(id){
  const m=S.mitarbeiter.find(x=>x.id===id);if(!m)return;
  document.getElementById('ma-vorname').value=m.vorname;document.getElementById('ma-nachname').value=m.nachname;
  document.getElementById('ma-rolle').value=m.rolle;document.getElementById('ma-tel').value=m.tel||'';
  document.getElementById('ma-email').value=m.email||'';document.getElementById('ma-datum').value=m.datum||'';
  document.getElementById('ma-notiz').value=m.notiz||'';
  maTags=[...m.quali];renderMaTags();
  S.mitarbeiter=S.mitarbeiter.filter(x=>x.id!==id);openModal('modal-mitarbeiter');
}
function addMaTag(e){if(e.key!=='Enter')return;const inp=document.getElementById('ma-tag-input');const v=inp.value.trim();if(!v||maTags.includes(v)){inp.value='';return;}maTags.push(v);inp.value='';renderMaTags();}
function removeMaTag(t){maTags=maTags.filter(x=>x!==t);renderMaTags();}
function renderMaTags(){
  const c=document.getElementById('ma-tags-container');const inp=document.getElementById('ma-tag-input');
  c.querySelectorAll('.tag-pill').forEach(p=>p.remove());
  maTags.forEach(tag=>{const pill=document.createElement('div');pill.className='tag-pill';pill.innerHTML=`${tag} <span class="rm" onclick="removeMaTag('${tag}')">✕</span>`;c.insertBefore(pill,inp);});
}

