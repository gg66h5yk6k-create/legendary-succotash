}

// ══════════ PROJEKTE ══════════
let aktiverProjFilter='alle';
function renderProjekte(filter){
  if(filter!==undefined)aktiverProjFilter=filter;
  const sm={laufend:'badge-green',pause:'badge-amber',planung:'badge-sky',abgeschlossen:'badge-gray'};
  const lm={laufend:'Laufend',pause:'Pause',planung:'Planung',abgeschlossen:'Abgeschlossen'};
  let data=S.projekte;
  if(aktiverProjFilter&&aktiverProjFilter!=='alle')data=data.filter(p=>p.status===aktiverProjFilter);
  const list=document.getElementById('projekte-list');
  if(!data.length){list.innerHTML=`<div class="empty-state"><div class="em-icon">🏗</div><p>Keine Projekte.</p><button class="btn btn-primary" onclick="openModal('modal-projekt')">Erstes Projekt anlegen</button></div>`;return;}
  list.innerHTML=data.map(p=>{
    const fotoHtml=p.fotos&&p.fotos.length?p.fotos.map(f=>`<div class="proj-foto-thumb"><img src="${f}" alt="Projektfoto"></div>`).join(''):'';
    return `<div class="proj-card">
      <div class="proj-card-header">
        <div>
          <div class="proj-name">${p.name}</div>
          <div class="proj-addr">📍 ${p.addr}</div>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:flex-start">
          <span class="badge ${sm[p.status]}">${lm[p.status]}</span>
          <button class="btn btn-pdf btn-sm" onclick="exportProjektPDF(${p.id})">📄</button>
          <button class="btn btn-ghost btn-sm" onclick="editProjekt(${p.id})">✏</button>
          <button class="btn btn-danger btn-sm" onclick="deleteProjekt(${p.id})">🗑</button>
        </div>
      </div>
      ${p.desc?`<div style="font-size:12px;color:var(--fog);line-height:1.5;margin-bottom:8px">${p.desc}</div>`:''}
      <div class="proj-info-grid">
        <div class="proj-info-cell"><div class="proj-info-label">Auftraggeber</div><div class="proj-info-value">${p.ag||'–'}</div></div>
        <div class="proj-info-cell"><div class="proj-info-label">Verantwortlich</div><div class="proj-info-value">${p.verantw||'–'}</div></div>
        <div class="proj-info-cell"><div class="proj-info-label">Beginn</div><div class="proj-info-value">${fmtDate(p.start)}</div></div>
        <div class="proj-info-cell"><div class="proj-info-label">Ende (geplant)</div><div class="proj-info-value">${fmtDate(p.end)}</div></div>
        <div class="proj-info-cell" style="grid-column:1/-1">
          <div class="proj-info-label">Fortschritt ${p.fortschritt||0}%</div>
          <div class="progress-bar"><div class="progress-fill" style="width:${p.fortschritt||0}%"></div></div>
        </div>
      </div>
      ${fotoHtml?`<div class="proj-foto-grid" style="margin-top:10px">${fotoHtml}</div>`:''}
    </div>`;
  }).join('');
}

function resetProjektForm(){
  S.tmpProjFotos=[];
  ['p-name','p-ag','p-addr','p-desc'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
  document.getElementById('p-status').value='planung';
  renderProjFotoGrid();
}

function handleProjFotoUpload(input){
  Array.from(input.files).forEach(file=>{
    const reader=new FileReader();
    reader.onload=e=>{S.tmpProjFotos.push(e.target.result);renderProjFotoGrid();};
    reader.readAsDataURL(file);
  });
  input.value='';
}

function renderProjFotoGrid(){
  const grid=document.getElementById('p-foto-grid');
  const thumbs=S.tmpProjFotos.map((src,i)=>`
    <div class="proj-foto-thumb">
      <img src="${src}" alt="Foto ${i+1}">
      <div style="position:absolute;top:2px;right:2px;background:rgba(184,92,42,.9);border-radius:2px;cursor:pointer;padding:2px 5px;font-size:10px;color:#fff" onclick="S.tmpProjFotos.splice(${i},1);renderProjFotoGrid()">✕</div>
    </div>`).join('');
  grid.innerHTML=thumbs+`<div class="proj-foto-add" onclick="document.getElementById('p-foto-upload').click()">＋</div>`;
}

function saveProjekt(){
  const name=document.getElementById('p-name').value.trim();
  if(!name){toast('Projektname erforderlich.','⚠️');return;}
  S.projekte.unshift({
    id:Date.now(),name,
    ag:document.getElementById('p-ag').value,
    status:document.getElementById('p-status').value,
    addr:document.getElementById('p-addr').value,
    start:document.getElementById('p-start').value,
    end:document.getElementById('p-end').value,
    verantw:document.getElementById('p-verantw').value,
    desc:document.getElementById('p-desc').value,
    fortschritt:0,
    fotos:[...S.tmpProjFotos],
  });
  S.tmpProjFotos=[];
  closeModal('modal-projekt');populateProjectSelects();renderAll();toast('Projekt gespeichert!','🏗');
}
function deleteProjekt(id){
  if(!confirm('Projekt löschen?'))return;
  S.projekte=S.projekte.filter(p=>p.id!==id);populateProjectSelects();renderAll();toast('Gelöscht.','🗑');
}
function editProjekt(id){
  const p=S.projekte.find(x=>x.id===id);if(!p)return;
  S.tmpProjFotos=[...(p.fotos||[])];
  document.getElementById('p-name').value=p.name;
  document.getElementById('p-ag').value=p.ag||'';
  document.getElementById('p-status').value=p.status;
  document.getElementById('p-addr').value=p.addr||'';
  document.getElementById('p-start').value=p.start||'';
  document.getElementById('p-end').value=p.end||'';
  document.getElementById('p-desc').value=p.desc||'';
  S.projekte=S.projekte.filter(x=>x.id!==id);
  renderProjFotoGrid();
  document.getElementById('modal-projekt').classList.add('open');
}

