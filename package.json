let berichtFilter='alle';
function setChip(el,ctx,val){
  el.closest('.filter-row').querySelectorAll('.filter-chip').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');
  if(ctx==='b'){berichtFilter=val;renderBerichte();}
  if(ctx==='s'){S.scanFilter=val;renderScans();}
}

function renderBerichte(search=''){
  const list=document.getElementById('berichte-list');
  let data=S.berichte;
  if(berichtFilter&&berichtFilter!=='alle')data=data.filter(b=>b.status===berichtFilter);
  if(search){const q=search.toLowerCase();data=data.filter(b=>b.projekt.toLowerCase().includes(q)||b.arbeiten.toLowerCase().includes(q)||b.datum.includes(q));}
  if(!data.length){list.innerHTML=`<div class="empty-state"><div class="em-icon">📋</div><p>Keine Berichte.</p><button class="btn btn-primary" onclick="openModal('modal-bericht')">Ersten erstellen</button></div>`;return;}
  const cm={abgeschlossen:'',teilweise:'amber',offen:'rust'};
  const bm={abgeschlossen:'badge-green',teilweise:'badge-amber',offen:'badge-rust'};
  const lm={abgeschlossen:'Erledigt',teilweise:'Teilweise',offen:'Offen'};
  list.innerHTML=data.map(b=>{
    // Personal summary
    const personal=[];
    if(b.vorarbeiter&&b.vorarbeiter.anz>0)personal.push(`<span class="personal-chip">VA: ${b.vorarbeiter.anz}x ${b.vorarbeiter.std}h</span>`);
    if(b.facharbeiter&&b.facharbeiter.anz>0)personal.push(`<span class="personal-chip">FA: ${b.facharbeiter.anz}x ${b.facharbeiter.std}h</span>`);
    if(b.helfer&&b.helfer.anz>0)personal.push(`<span class="personal-chip">HE: ${b.helfer.anz}x ${b.helfer.std}h</span>`);
    if(b.maschinen&&b.maschinen.length)b.maschinen.forEach(m=>personal.push(`<span class="personal-chip maschine-chip">🚜 ${m.name}: ${m.std}h</span>`));
    const totalStd=((b.vorarbeiter?.anz||0)*(b.vorarbeiter?.std||0))+((b.facharbeiter?.anz||0)*(b.facharbeiter?.std||0))+((b.helfer?.anz||0)*(b.helfer?.std||0));
    const lsThumbs=b.lieferscheine&&b.lieferscheine.length?`<div class="ls-list">${b.lieferscheine.map((ls,i)=>`<div class="ls-bericht-thumb" onclick="viewLieferschein('${b.id}',${i})"><img src="${ls.src}" alt="LS"></div>`).join('')}</div>`:'';
    return `<div class="bericht-card ${cm[b.status]}">
      <div class="bericht-top">
        <div>
          <div class="bericht-date">${fmtDateLong(b.datum)}</div>
          <div class="bericht-projekt">📍 ${b.projekt}</div>
        </div>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
          <span class="badge ${bm[b.status]}">${lm[b.status]}</span>
          <button class="btn btn-pdf btn-sm" onclick="exportEinzelBerichtPDF(${b.id})">📄</button>
          <button class="btn btn-danger btn-sm" onclick="deleteBericht(${b.id})">🗑</button>
        </div>
      </div>
      <div class="bericht-text">${b.arbeiten}</div>
      ${personal.length?`<div class="bericht-personal">${personal.join('')}</div>`:''}
      <div class="meta-row">
        <span class="meta-item">⏱ Gesamt ${totalStd.toFixed(1)} Std.</span>
        ${b.wetter?`<span class="meta-item">${b.wetter}</span>`:''}
        ${b.lieferscheine&&b.lieferscheine.length?`<span class="meta-item">📦 ${b.lieferscheine.length} Lieferschein(e)</span>`:''}
      </div>
      ${lsThumbs}
    </div>`;
  }).join('');
}

function viewLieferschein(berichtId,idx){
  const b=S.berichte.find(x=>x.id==berichtId);
  if(!b||!b.lieferscheine[idx])return;
  const win=window.open('','_blank');
  win.document.write(`<html><body style="margin:0;background:#000"><img src="${b.lieferscheine[idx].src}" style="max-width:100%;height:auto"></body></html>`);
}

function deleteBericht(id){
  if(!confirm('Bericht löschen?'))return;
  S.berichte=S.berichte.filter(b=>b.id!==id);renderBerichte();updateStats();renderDashboard();toast('Gelöscht.','🗑');
}

// ══════════ FOTOTHEK ══════════
const BGCOLORS=['#2d4a1e','#1a3d2b','#3d2d0f','#1c3448','#3d1f1a'];

function handleFotoUpload(input){
  const files=Array.from(input.files);
  if(!files.length)return;
  let loaded=0;
  files.forEach(file=>{
    const reader=new FileReader();
    reader.onload=function(e){
      S.fotos.unshift({id:Date.now()+Math.random(),src:e.target.result,name:file.name,projekt:'–',datum:new Date().toISOString().split('T')[0]});
      loaded++;
      if(loaded===files.length){renderFotos();updateStats();toast(files.length+' Foto(s) hinzugefügt!','📷');}
    };
    reader.readAsDataURL(file);
  });
  input.value='';
}

function renderFotos(){
  const grid=document.getElementById('photo-grid');
  if(!grid)return;
  const addCell=`<div class="photo-add-cell" onclick="document.getElementById('foto-upload').click()"><div class="plus">＋</div><div>Foto hinzufügen</div></div>`;
  const cells=S.fotos.map((f,i)=>{
    const bg=BGCOLORS[i%BGCOLORS.length];
    const imgContent=f.src
      ?`<img src="${f.src}" alt="${f.name}" loading="lazy">`
      :`<div class="photo-placeholder" style="background:${bg}">🌿</div>`;
    const canShare=!!navigator.share&&!!f.src;
    return `<div class="photo-cell">
      <div class="photo-img-wrap">${imgContent}</div>
      <div class="photo-caption">${f.name}</div>
      <div class="photo-actions">
        ${canShare?`<button class="photo-action-btn share" onclick="shareFoto(${f.id})">⬆ Teilen</button>`:''}
        <button class="photo-action-btn del" onclick="deleteFoto(${f.id})">🗑 Löschen</button>
      </div>
    </div>`;
  }).join('');
  grid.innerHTML=cells+addCell;
}

async function shareFoto(id){
  const f=S.fotos.find(x=>x.id===id);
  if(!f||!f.src){toast('Kein Bild zum Teilen.','⚠️');return;}
  try{
    if(navigator.share&&navigator.canShare){
      const res=await fetch(f.src);const blob=await res.blob();
      const file=new File([blob],f.name,{type:blob.type});
      if(navigator.canShare({files:[file]})){
        await navigator.share({files:[file],title:f.name});return;
      }
    }
    if(navigator.share){await navigator.share({title:f.name,text:f.name});return;}
    window.open(f.src,'_blank');
  }catch(e){if(e.name!=='AbortError')window.open(f.src,'_blank');}
}

function deleteFoto(id){
  if(!confirm('Foto löschen?'))return;
  S.fotos=S.fotos.filter(f=>f.id!==id);renderFotos();updateStats();toast('Foto gelöscht.','🗑');
}

// ══════════ DOKUMENTE ══════════
const typeIcons={pdf:'📄',doc:'📝',xls:'📊',img:'🖼',other:'📎'};
const typeCss={pdf:'file-icon-pdf',doc:'file-icon-doc',xls:'file-icon-xls',img:'file-icon-img',other:''};
function getFileType(n){
  const ext=n.split('.').pop().toLowerCase();
  if(['pdf'].includes(ext))return'pdf';if(['doc','docx','txt'].includes(ext))return'doc';
  if(['xls','xlsx','csv'].includes(ext))return'xls';if(['jpg','jpeg','png','gif','webp'].includes(ext))return'img';
  return'other';
}
function renderDokumente(search=''){
  const list=document.getElementById('doc-list');
  let data=S.dokumente;
  if(search){const q=search.toLowerCase();data=data.filter(d=>d.name.toLowerCase().includes(q)||d.projekt.toLowerCase().includes(q));}
  if(!data.length){list.innerHTML=`<div class="empty-state"><div class="em-icon">📁</div><p>Keine Dokumente.</p></div>`;return;}
  list.innerHTML=data.map(d=>`
    <div class="file-row">
      <div class="file-icon ${typeCss[getFileType(d.name)]}">${typeIcons[getFileType(d.name)]}</div>
      <div class="file-meta"><div class="file-name">${d.name}</div><div class="file-info">📍 ${d.projekt} · ${d.datum} · ${d.size}</div></div>
      <button class="btn btn-ghost btn-icon btn-sm" onclick="deleteDoc(${d.id})">🗑</button>
    </div>`).join('');
}
function handleDocUpload(input){
  Array.from(input.files).forEach(file=>{
    const sz=Math.round(file.size/1024);
    S.dokumente.unshift({id:Date.now()+Math.random(),name:file.name,typ:getFileType(file.name),projekt:'–',datum:new Date().toISOString().split('T')[0],size:sz>1024?(sz/1024).toFixed(1)+' MB':sz+' KB'});
  });
  input.value='';renderDokumente();updateStats();toast(input.files.length+' Dokument(e) geladen!','📁');
}
function handleDocDrop(e){
  Array.from(e.dataTransfer.files).forEach(file=>{
    const sz=Math.round(file.size/1024);
    S.dokumente.unshift({id:Date.now()+Math.random(),name:file.name,typ:getFileType(file.name),projekt:'–',datum:new Date().toISOString().split('T')[0],size:sz>1024?(sz/1024).toFixed(1)+' MB':sz+' KB'});
  });
  renderDokumente();updateStats();toast('Dateien hinzugefügt!','✅');
}
function deleteDoc(id){if(!confirm('Löschen?'))return;S.dokumente=S.dokumente.filter(d=>d.id!==id);renderDokumente();updateStats();toast('Gelöscht.','🗑');}

