<div id="toast"></div>

<script>

// ══════════ PERSISTENZ / TEAM-SYNC / USER / HELPERS ══════════
const APP_VERSION='netlify-sync-v3';
const STORAGE_PREFIX='lb_state_'+APP_VERSION+'_';
const USERS_KEY='lb_users_'+APP_VERSION;
const ACTIVE_USER_KEY='lb_active_user_'+APP_VERSION;
const LAST_SECTION_KEY='lb_last_section_'+APP_VERSION;

// Team-Sync (gemeinsame Daten über Netlify Functions + Netlify Blobs)
const TEAM_DEFAULT='LB-gb';
const TEAM_KEY='lb_team_'+APP_VERSION;
const TEAM_STAMP_KEY='lb_team_stamp_'+APP_VERSION;
let TEAM=(localStorage.getItem(TEAM_KEY) || TEAM_DEFAULT).trim();
let TEAM_STAMP=(localStorage.getItem(TEAM_STAMP_KEY) || '').trim();
let _syncSuppress=false;
let _syncPushTimer=null;
let _autosaveLast='';

function clone(obj){return JSON.parse(JSON.stringify(obj));}
function num(v){
  if(v===null||v===undefined) return 0;
  if(typeof v==='number') return isFinite(v)?v:0;
  const s=String(v).trim().replace(',', '.');
  const n=parseFloat(s);
  return isFinite(n)?n:0;
}

function loadUsers(){
  try{
    const raw=localStorage.getItem(USERS_KEY);
    const users=raw?JSON.parse(raw):null;
    if(Array.isArray(users) && users.length) return users;
  }catch(e){}
  const u=[{id:'default',name:'Standard'}];
  localStorage.setItem(USERS_KEY, JSON.stringify(u));
  localStorage.setItem(ACTIVE_USER_KEY, 'default');
  return u;
}
function getActiveUser(){
  const users=loadUsers();
  const active=localStorage.getItem(ACTIVE_USER_KEY) || (users[0]&&users[0].id) || 'default';
  if(!users.some(u=>u.id===active)){
    localStorage.setItem(ACTIVE_USER_KEY, users[0].id);
    return users[0].id;
  }
  return active;
}
function setActiveUser(id){ localStorage.setItem(ACTIVE_USER_KEY, id); }
function stateKeyFor(userId){ return STORAGE_PREFIX + userId; }
function stateKey(){ return stateKeyFor(getActiveUser()); }

function _persistLocal(){
  try{localStorage.setItem(stateKey(), JSON.stringify(S));}catch(e){}
}

function saveState(){
  _persistLocal();
  if(!_syncSuppress) scheduleTeamPush();
}
function loadState(){
  try{ const raw=localStorage.getItem(stateKey()); return raw?JSON.parse(raw):null; }catch(e){ return null; }
}
function resetStateToDefault(){ try{localStorage.removeItem(stateKey());}catch(e){} }

function wireDecimalInput(el){
  if(!el) return;
  el.addEventListener('input', function(){ if(this.value && this.value.includes(',')) this.value=this.value.replace(',', '.'); });
}

function buildTeamBundle(){
  const users=loadUsers();
  const states={};
  users.forEach(u=>{
    try{
      const raw=localStorage.getItem(stateKeyFor(u.id));
      states[u.id]= raw? JSON.parse(raw) : null;
    }catch(e){ states[u.id]=null; }
  });
  return { team: TEAM, users, activeUser: getActiveUser(), states };
}

function applyTeamBundle(bundle, stamp){
  if(!bundle || !bundle.users || !bundle.states) return;
  _syncSuppress=true;
  try{
    localStorage.setItem(USERS_KEY, JSON.stringify(bundle.users));
    Object.keys(bundle.states).forEach(uid=>{
      const st=bundle.states[uid];
      if(st) localStorage.setItem(stateKeyFor(uid), JSON.stringify(st));
    });
    TEAM_STAMP=stamp||''; localStorage.setItem(TEAM_STAMP_KEY, TEAM_STAMP);
    const current=getActiveUser();
    const hasCurrent=bundle.users.some(u=>u.id===current);
    if(!hasCurrent && bundle.activeUser) localStorage.setItem(ACTIVE_USER_KEY, bundle.activeUser);
  }finally{ _syncSuppress=false; }
}

async function teamPull(showToast=false){
  try{
    const url=`/.netlify/functions/state?team=${encodeURIComponent(TEAM)}`;
    const resp=await fetch(url);
    if(!resp.ok) return;
    const data=await resp.json();
    const stamp=(data.stamp||'');
    if(stamp && stamp===TEAM_STAMP) return;
    if(data.bundle){
      applyTeamBundle(data.bundle, stamp);
      S = loadState() || clone(DEFAULT_STATE);
      _persistLocal();
      renderAll();
      populateProjectSelects();
      if(showToast) toast('Team-Daten aktualisiert.','☁️');
    }
  }catch(e){}
}

function scheduleTeamPush(ms=900){
  if(_syncSuppress) return;
  if(_syncPushTimer) clearTimeout(_syncPushTimer);
  _syncPushTimer=setTimeout(()=>teamPush(), ms);
}

async function teamPush(){
  try{
    const url=`/.netlify/functions/state?team=${encodeURIComponent(TEAM)}`;
    const body={ stamp: TEAM_STAMP, by: (loadUsers().find(u=>u.id===getActiveUser())||{}).name||'', bundle: buildTeamBundle() };
    const resp=await fetch(url, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)});
    if(resp.status===409){
      await teamPull(false);
      toast('Konflikt: Team-Stand aktualisiert. Bitte erneut speichern.','⚠️');
      return;
    }
    if(!resp.ok) return;
    const data=await resp.json().catch(()=>null);
    if(data && data.stamp){ TEAM_STAMP=data.stamp; localStorage.setItem(TEAM_STAMP_KEY, TEAM_STAMP); }
  }catch(e){}
}

function setTeamNameUI(){
  const t=prompt('Team-Name (gemeinsame Daten):', TEAM);
  if(!t) return;
  TEAM=t.trim();
  localStorage.setItem(TEAM_KEY, TEAM);
  teamPull(true);
}

function startAutosave(){
  try{ _autosaveLast = JSON.stringify(S); }catch(e){ _autosaveLast=''; }
  setInterval(()=>{
    if(_syncSuppress) return;
    let now='';
    try{ now=JSON.stringify(S); }catch(e){ return; }
    if(now && now!==_autosaveLast){
      _autosaveLast=now;
      _persistLocal();
      scheduleTeamPush(900);
    }
  }, 1200);
}
// ══════════ PWA ══════════
if('serviceWorker' in navigator){
  const sw=`const C='lb-netlify-sync-v3';
const ASSETS=['./'];
self.addEventListener('install',e=>e.waitUntil(caches.open(C).then(c=>c.addAll(ASSETS))));
self.addEventListener('activate',e=>e.waitUntil(caches.keys().then(k=>Promise.all(k.filter(x=>x!==C).map(x=>caches.delete(x))))));
self.addEventListener('fetch',e=>{
  if(e.request.method!=='GET') return;
  e.respondWith((async()=>{
    const cache=await caches.open(C);
    const cached=await cache.match(e.request);
    if(cached) return cached;
    try{
      const res=await fetch(e.request);
      try{ if(new URL(e.request.url).origin===self.location.origin) cache.put(e.request,res.clone()); }catch(_){}
      return res;
    }catch(err){
      return cached||cache.match('./');
    }
  })());
});`;
 navigator.serviceWorker.register(URL.createObjectURL(new Blob([sw],{type:'application/javascript'}))).catch(()=>{});
}
let deferredPrompt=null;
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferredPrompt=e;if(!localStorage.getItem('installDismissed'))document.getElementById('install-banner').classList.add('show');});
function installApp(){if(!deferredPrompt)return;deferredPrompt.prompt();deferredPrompt.userChoice.then(()=>{deferredPrompt=null;dismissInstall();});}
function dismissInstall(){document.getElementById('install-banner').classList.remove('show');localStorage.setItem('installDismissed','1');}
if(/iphone|ipad|ipod/i.test(navigator.userAgent)&&!window.navigator.standalone&&!localStorage.getItem('iosHintShown')){setTimeout(()=>{document.getElementById('ios-hint').classList.add('show');localStorage.setItem('iosHintShown','1');},2500);}

