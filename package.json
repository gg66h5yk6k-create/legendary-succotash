// Aktiver Benutzer + State laden
let S = (()=>{
  const loaded = loadState();
  if(loaded){
    const base = clone(DEFAULT_STATE);
    try{ return Object.assign(base, loaded); }catch(e){ return loaded; }
  }
  return clone(DEFAULT_STATE);
})();


